# Backend configuration only. Copy to .env.local and fill real existing resources.
OCI_CONFIG_FILE=.local/oci-config
OCI_PROFILE=DEFAULT
OCI_REGION=ap-hyderabad-1
OCI_COMPARTMENT_ID=
GENAI_REGION=us-chicago-1
GENAI_ENDPOINT=https://inference.generativeai.us-chicago-1.oci.oraclecloud.com
BASELINE_MODEL_ID=
BASELINE_MODEL_NAME=GPT-5.4 mini
BASELINE_SERVING_MODE=ON_DEMAND
CANDIDATE_MODEL_ID=
CANDIDATE_MODEL_NAME=Gemini 2.5 Flash
CANDIDATE_SERVING_MODE=ON_DEMAND
JUDGE_MODEL_ID=
JUDGE_MODEL_NAME=GPT-5.4
JUDGE_SERVING_MODE=ON_DEMAND
GENAI_MAX_COMPLETION_TOKENS=2048
GENAI_VERBOSITY=MEDIUM
# Gemini 2.5 uses these parameters instead of GPT completion/verbosity settings.
GEMINI_MAX_TOKENS=6000
GEMINI_TEMPERATURE=1
GEMINI_FREQUENCY_PENALTY=0
GEMINI_PRESENCE_PENALTY=0
GEMINI_TOP_P=0.95
# Gemini 2.5 Top-K is fixed at 64 by the model service.
GENAI_TIMEOUT_MS=180000
WORKER_CONCURRENCY=2
DB_USER=
DB_PASSWORD=
DB_CONNECT_STRING=
DB_WALLET_DIR=.local/wallet
DB_WALLET_PASSWORD=
OBJECT_STORAGE_REGION=ap-hyderabad-1
OBJECT_STORAGE_NAMESPACE=
OBJECT_STORAGE_BUCKET=ai-model-evaluation
# This project's root must be ai-model-evaluation-promptfoo/ or a child folder.
# Legacy OBJECT_STORAGE_PREFIX, PORT and UI_ORIGIN are deliberately ignored.
PROMPTFOO_OBJECT_STORAGE_PREFIX=ai-model-evaluation-promptfoo/
LOCAL_REVIEWER=local-operator (unauthenticated)
PROMPTFOO_PORT=3002
PROMPTFOO_UI_ORIGIN=http://127.0.0.1:3002
